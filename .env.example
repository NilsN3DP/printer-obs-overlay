# Hinweis: Fuer MEHRERE Drucker stattdessen eine config.json anlegen
# (siehe config.example.json). Diese .env ist nur der Einzeldrucker-Fallback.

# IP-Adresse oder Hostname deines Prusa-Druckers im lokalen Netzwerk
PRUSA_HOST=192.168.1.50

# PrusaLink-Zugang. Digest-Login wird unterstuetzt; API-Key ist optional als Alternative moeglich.
PRUSA_USERNAME=maker
PRUSA_PASSWORD=DEIN_PRUSALINK_PASSWORT
PRUSA_API_KEY=

# Anzeigename des Druckers (optional)
PRUSA_NAME=Core One

# Port, auf dem der lokale Overlay-Server laeuft
PORT=4200

# Abfrageintervall des Servers beim Drucker in Millisekunden
POLL_INTERVAL_MS=2000
