{
  "name": "printer-obs-overlay",
  "version": "2.0.0",
  "description": "Stream-Overlay fuer 3D-Drucker (PrusaLink, OctoPrint, Moonraker) - als Docker-Container, Windows-App oder natives OBS-Plugin",
  "license": "MIT",
  "type": "module",
  "main": "src/server/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server/main.js",
    "dev": "node --watch src/server/main.js --open",
    "test": "node --test \"test/*.test.js\"",
    "build:fonts": "node scripts/build.mjs fonts",
    "build:exe": "node scripts/build.mjs exe",
    "build:obs": "powershell -NoProfile -ExecutionPolicy Bypass -File packaging/obs-plugin/build.ps1",
    "build:installer": "node scripts/build.mjs installer",
    "build:all": "node scripts/build.mjs all"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "esbuild": "^0.25.0",
    "postject": "^1.0.0-alpha.6",
    "rcedit": "^5.0.2"
  }
}
